const string G_HTF           = "Higher-Timeframe Plot of HA Engine"
const string G_PIVOT         = "Left/Right Trend Pivot Overlay"
const string G_GUIDE         = "Guide Lines"
const string G_VIS           = "Visuals"
const string G_PRICE_CANDLES = "Price Chart Plotcandles"
const string G_OSC_PRESSURE  = "HA Engine Candle Pressure"
const string G_TABLE         = "Engine Table"

