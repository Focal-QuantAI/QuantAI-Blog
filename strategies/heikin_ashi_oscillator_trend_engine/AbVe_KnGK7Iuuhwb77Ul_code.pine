const string TT_ENGINE_MODE =
     "Chooses which version of the oscillator the script uses.\n\n" +
     "• HA Range Base:\n" +
     "  A more direct and responsive version.\n" +
     "  It can react faster to changes, but may look less smooth.\n\n" +
     "• HA Blend:\n" +
     "  A smoother version built from several blended components.\n" +
     "  It can help reduce noise, but may react a little slower."

const string TT_PLOT_LAST =
     "Number of most recent bars shown for the histogram (default is plot.style_line) and any plots still tied to the main history control."

