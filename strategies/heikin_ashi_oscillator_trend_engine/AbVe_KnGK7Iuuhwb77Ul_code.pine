string in_lookbackMode = input.string(
     defval="Dynamic",
     title="Lookback Mode",
     options=["Dynamic", "Manual"],
     group=G_ENGINE,
     tooltip=TT_DYNAMIC_LOOKBACK)

bool in_useDynamicLookback =
     in_lookbackMode == "Dynamic"

